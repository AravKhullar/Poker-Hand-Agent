# Secrets — never commit real values
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# uv
.python-version.local

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Type checkers
.mypy_cache/
.pyright/

# IDEs
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Data — keep the repo light; document how to obtain/build these instead.
# Comment these out if you intend to commit a small sample corpus/eval set.
data/corpus/*
data/eval/*
!data/corpus/.gitkeep
!data/eval/.gitkeep

# Local Postgres volume if mounted into the repo
pgdata/

# Notebooks checkpoints
.ipynb_checkpoints/

# Model / embedding caches
*.pkl
*.faiss