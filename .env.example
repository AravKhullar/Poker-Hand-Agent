# Chat model, as a LangChain "provider:model" string.
#   Local (no quota):  ollama:qwen3.5:9b          (run `ollama pull qwen3.5:9b`)
#   Gemini API:        google_genai:gemini-3.8-flash  (needs GOOGLE_API_KEY)
CHAT_MODEL=ollama:qwen3.5:9b
GOOGLE_API_KEY=

# Embeddings — must emit 768 dims to match schema.sql (`ollama pull nomic-embed-text`).
# Changing this means re-running ingestion.
EMBEDDING_MODEL=ollama:nomic-embed-text

DATABASE_URL=postgresql://poker:poker@localhost:5432/pokeragent
